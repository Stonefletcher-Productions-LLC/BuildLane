{
  "name": "LifeShare",
  "repo": "Stonefletcher-Productions-LLC/LifeShare",
  "branch": "main",
  "workflow": "lane.yml",
  "planWorkflow": "build-plan-shadow.yml",
  "activeJobs": "ci.yml|Build and test;ci.yml|focused;compile-preview.yml|Compile only (not release validation)",
  "statusFile": "E:\\GitHubRunner\\status.json",
  "pauseFile": "E:\\GitHubRunner\\PAUSED",
  "runnerPath": "E:\\GitHubRunner\\LifeShare",
  "drive": "E",
  "serviceFilter": "*lifeshare*",
  "cachePort": 8558,
  "minimumFreeGB": 12,
  "cleanBelowGB": 25,
  "workers": {
    "enabled": true,
    "projectRoot": "E:\\lifeshare-scratch\\foreman\\host",
    "baseBranch": "Test-Staging",
    "label": "foreman",
    "assignee": "ProjektPayne",
    "stateDir": "E:\\lifeshare-scratch\\foreman",
    "worktreeRoot": "E:\\lifeshare-scratch\\foreman\\worktrees",
    "maxParallel": 2,
    "pollMinutes": 10,
    "auth": "subscription",
    "dailyBudgetUsd": 60,
    "dashboardPort": 8770,
    "plugin": "Tools/ClaudePlugin/lifeshare-guard",
    "agents": [
      {
        "name": "claude",
        "kind": "claude",
        "tier": 4,
        "vendor": "anthropic"
      },
      {
        "name": "codex",
        "kind": "codex",
        "tier": 3,
        "vendor": "openai",
        "enabled": false
      },
      {
        "name": "deepseek-pro",
        "kind": "opencode",
        "model": "opencode-go/deepseek-v4-pro",
        "tier": 2,
        "vendor": "deepseek"
      },
      {
        "name": "deepseek",
        "kind": "opencode",
        "model": "opencode-go/deepseek-v4.1-flash",
        "tier": 1,
        "vendor": "deepseek"
      }
    ],
    "routing": {
      "easy": [
        "deepseek",
        "deepseek-pro"
      ],
      "medium": [
        "deepseek-pro",
        "claude",
        "codex"
      ],
      "hard": [
        "claude",
        "codex"
      ],
      "reviewers": [
        "claude",
        "codex"
      ]
    }
  }
}
